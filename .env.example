# ============================================================================
# Afritecx Badboy — Environment Configuration
# ----------------------------------------------------------------------------
# Copy to ".env" for local development, or set these variables in your hosting
# platform. Never commit a real .env file.
# ============================================================================

# --- Frontend (build time) ---------------------------------------------------
# Leave EMPTY to run offline on the browser database (localStorage).
# Set to "/api" when the Node server hosts the frontend and the API together
# (this is what .env.production does for a production build).
# Set to a full URL such as https://pos.example.com/api when the API lives on
# a different origin; that origin must also appear in CORS_ORIGINS below.
VITE_API_BASE_URL=

# --- Server ------------------------------------------------------------------
# Address to bind. Use 0.0.0.0 inside a container so the port is reachable
# from outside; keep 127.0.0.1 when a reverse proxy runs on the same host.
HOST=127.0.0.1
PORT=8787

# Directory holding afritecx.db. Must be on persistent storage in production.
DB_DIR=./server/data

# Set to "production" in production. This also makes the server refuse to start
# while any demo password still works.
NODE_ENV=development

# Set to 0 to run as a pure API when a separate web server serves the frontend.
SERVE_STATIC=1

# Comma-separated list of browser origins allowed to call the API. Only needed
# when the frontend is on a different origin from the API.
CORS_ORIGINS=

# --- First-run credentials ---------------------------------------------------
# These are only read when the database is created for the first time. Changing
# them later does NOT change an existing database.
SEED_ADMIN_PASSWORD=
SEED_CASHIER_PASSWORD=
SEED_GENERAL_PASSWORD=
SEED_AUDIT_PASSWORD=
